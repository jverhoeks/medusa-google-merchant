{
  "name": "@jverhoeks/medusa-google-merchant",
  "version": "0.1.0-rc.3",
  "description": "Configurable Google Merchant XML feeds and product selection for Medusa v2",
  "license": "MIT",
  "author": "Jacob Verhoeks",
  "repository": {
    "type": "git",
    "url": "https://github.com/jverhoeks/medusa-google-merchant.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.19.0",
  "files": [
    ".medusa/server",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js"
    },
    "./core": "./.medusa/server/src/lib/feed.js",
    "./loader": "./.medusa/server/src/lib/loader.js",
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./*": "./.medusa/server/src/*.js",
    "./options": "./.medusa/server/src/lib/options.js"
  },
  "scripts": {
    "build": "medusa plugin:build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/admin/tsconfig.json",
    "test": "node --import tsx --test tests/*.test.mjs",
    "prepack": "npm run build",
    "pack:feed": "node scripts/pack-feed.cjs"
  },
  "keywords": [
    "medusa-v2",
    "medusa-plugin-integration",
    "medusa-plugin-other",
    "google-merchant",
    "product-feed"
  ],
  "peerDependencies": {
    "@medusajs/admin-sdk": "2.22.1",
    "@medusajs/framework": "2.22.1",
    "@medusajs/icons": "2.22.1",
    "@medusajs/js-sdk": "2.22.1",
    "@medusajs/medusa": "2.22.1",
    "@medusajs/ui": "4.2.8",
    "@tanstack/react-query": "^5.64.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@medusajs/admin-sdk": "2.22.1",
    "@medusajs/cli": "2.22.1",
    "@medusajs/framework": "2.22.1",
    "@medusajs/icons": "2.22.1",
    "@medusajs/js-sdk": "2.22.1",
    "@medusajs/medusa": "2.22.1",
    "@medusajs/ui": "4.2.8",
    "@swc/core": "^1.7.28",
    "@tanstack/react-query": "5.64.2",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.6.2",
    "vite": "^7.3.6",
    "@medusajs/types": "2.22.1"
  }
}
